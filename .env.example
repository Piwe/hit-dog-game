# Copy to .env and fill in. .env is gitignored -- this repo is public.
#
# Used only by tools/audio_gen.py at BUILD time. The browser never sees a key:
# audio is generated once, committed to assets/audio/, and served statically.

ELEVENLABS_API_KEY=

# Reserved for a future tools/art_gen.py (jump cycle, foreground parallax).
GOOGLE_API_KEY=
