# Verification renders from tools/preview.py and tools/derive.py.
# Regenerate with: npm run preview
build/

# Python bytecode from the asset pipeline
__pycache__/
*.pyc

# Claude Code per-machine settings
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Node, if dependencies are ever added
node_modules/

# NOTE: assets/ IS committed on purpose, even though it is build output.
# The game cannot run without it, the pipeline is deterministic so it never
# produces spurious diffs, and committing it means a clone can be played
# without installing Pillow and SciPy -- which is what the README promises.
#
# NOTE: images/ is the irreplaceable source art. Never ignore it.
